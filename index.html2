(function DREAMORA_CHAT_V2(){
  const _renderChatList = window.renderChatList || renderChatList;
  window.renderChatList = function(){
    const list=document.getElementById('chatList');
    if(!list) return;
    const chats=getChats();
    if(!chats.length){
      list.innerHTML='<div class="empty-state" style="padding:45px 15px;color:#777;text-align:center">✦<br><br>No dream conversations yet.<br><span style="font-size:11px">Search someone above or create a group.</span></div>';
      return;
    }
    list.innerHTML=chats.map((c,i)=>`<div class="chat-row" onclick="openChatRoom(${i})"><div class="chat-avatar">${escapeHTML((c.name||'D').charAt(0).toUpperCase())}</div><div class="chat-meta"><div class="chat-name">${escapeHTML(c.name)}${c.group?' <span style="font-size:10px;color:#777">· group</span>':''}</div><div class="chat-preview">${escapeHTML(c.last||'No messages yet')}</div></div><div class="chat-time">${escapeHTML(c.time||'now')}</div></div>`).join('');
  };
  window.openChat=function(){document.getElementById('chatOverlay')?.classList.add('open');renderChatList();};
  window.toggleChatExtras=toggleChatExtras;
  setTimeout(()=>renderChatList(),0);
})();


/* ===== DREAMORA V3 LIVE CHAT ENGINE ===== */
(function DREAMORA_LIVE_CHAT_V3(){
  const CHANNEL_NAME='dreamora_live_chat_v3';
  let liveChannel=null;
  try{ liveChannel=new BroadcastChannel(CHANNEL_NAME); }catch(e){ liveChannel=null; }
  let typingTimer=null;
  let typingRemoteTimer=null;
  let lastRenderedMessageCount=0;
  let lastChatSnapshot='';

  const esc=(s)=>{ if(typeof escapeHTML==='function') return escapeHTML(String(s??'')); return String(s??'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m])); };
  const nowTime=()=>new Date().toLocaleTimeString([], {hour:'2-digit',minute:'2-digit'});
  const uid=()=>`m_${Date.now()}_${Math.random().toString(36).slice(2,8)}`;
  const getIdentity=()=>{
    let username=localStorage.getItem('dreamoraCurrentUser')||localStorage.getItem('dreamoraUsername')||'you';
    username=String(username).trim()||'you';
    return {username,name:username};
  };
  const chatKey=(c,i)=>String(c.id||c.chatId||`chat_${i}_${c.name||''}`).replace(/[^a-zA-Z0-9_-]/g,'_');
  const readChats=()=>{ try{return typeof getChats==='function'?getChats():(JSON.parse(localStorage.getItem('dreamoraChats')||'[]')||[]);}catch(e){return [];} };
  const writeChats=(chats)=>{ try{ if(typeof saveChats==='function') saveChats(chats); else localStorage.setItem('dreamoraChats',JSON.stringify(chats)); }catch(e){} };
  const getActiveIndex=()=> (typeof activeChat!=='undefined' ? activeChat : null);
  const getActive=()=>{const i=getActiveIndex();const cs=readChats();return i===null||!cs[i]?null:{chat:cs[i],index:i,chats:cs};};

  function ensureIds(){
    const chats=readChats(); let changed=false;
    chats.forEach((c,i)=>{if(!c.id){c.id=`chat_${Date.now()}_${i}_${Math.random().toString(36).slice(2,6)}`;changed=true;} if(!Array.isArray(c.messages)) {c.messages=[];changed=true;} c.messages.forEach(m=>{if(!m.id)m.id=uid(); if(!m.time)m.time=nowTime();});});
    if(changed) writeChats(chats);
  }

  function typingBox(){
    const room=document.getElementById('chatRoom'); if(!room)return null;
    let el=document.getElementById('liveTypingIndicator');
    if(!el){
      el=document.createElement('div'); el.id='liveTypingIndicator'; el.className='live-typing';
      el.innerHTML='<div class="typing-stars" aria-hidden="true"><span>✦</span><span>✦</span><span>✦</span></div><span id="liveTypingText">Someone is typing…</span>';
      const msg=document.getElementById('messageList');
      if(msg && msg.parentNode) msg.parentNode.insertBefore(el,msg.nextSibling);
    }
    return el;
  }
  function setTypingVisible(show,name){
    const el=typingBox(); if(!el)return;
    const txt=document.getElementById('liveTypingText'); if(txt)txt.textContent=`${name||'Someone'} is typing…`;
    el.classList.toggle('show',!!show);
    const status=document.querySelector('#chatRoom .room-status');
    if(status) {status.classList.toggle('live',!!show);status.textContent=show?'typing…':'DREAMORA chat';}
  }

  function broadcast(payload){ try{liveChannel&&liveChannel.postMessage(payload);}catch(e){} }
  function emitTyping(){
    const a=getActive(); if(!a)return;
    const identity=getIdentity();
    broadcast({type:'typing',chatId:chatKey(a.chat,a.index),name:identity.name,username:identity.username,at:Date.now()});
    clearTimeout(typingTimer);
    typingTimer=setTimeout(()=>broadcast({type:'stopTyping',chatId:chatKey(a.chat,a.index),username:identity.username,at:Date.now()}),1300);
  }

  function handleInput(){
    const input=document.getElementById('messageInput'); if(!input)return;
    if(input.value.trim()) emitTyping();
  }

  function renderLiveMessages(force=false){
    const a=getActive(); if(!a)return;
    const box=document.getElementById('messageList'); if(!box)return;
    const msgs=a.chat.messages||[];
    const sig=msgs.map(m=>m.id||m.text||'').join('|');
    if(!force && sig===lastChatSnapshot)return;
    const oldCount=lastRenderedMessageCount;
    lastChatSnapshot=sig; lastRenderedMessageCount=msgs.length;
    const html=msgs.length?msgs.map(m=>{
      const mine=!!m.mine;
      const sender=m.senderName||m.username|| (mine?'You':a.chat.name||'Dreamer');
      return `<div class="message-row ${mine?'mine':'theirs'}"><div class="message-sender">${esc(sender)}</div><div class="bubble ${mine?'mine':''} ${msgs.length>oldCount?'new-message':''}">${esc(m.text||'')}<div class="message-time">${esc(m.time||'')}</div></div></div>`;
    }).join(''):'<div style="text-align:center;color:#666;padding:35px 10px">Start the conversation 🌙</div>';
    box.innerHTML=html;
    box.scrollTop=box.scrollHeight;
  }

  function saveIncoming(chatId,msg){
    const chats=readChats();
    let idx=chats.findIndex((c,i)=>chatKey(c,i)===chatId);
    if(idx<0)return;
    chats[idx].messages=chats[idx].messages||[];
    if(!chats[idx].messages.some(m=>m.id===msg.id)){
      chats[idx].messages.push(msg); chats[idx].last=msg.text||''; chats[idx].time=msg.time||nowTime(); writeChats(chats);
    }
    if(getActiveIndex()===idx){lastChatSnapshot='';renderLiveMessages(true);}
    if(typeof renderChatList==='function')renderChatList();
  }

  if(liveChannel){
    liveChannel.onmessage=(ev)=>{
      const p=ev.data||{};
      const a=getActive();
      if(p.type==='typing'){
        if(!a || chatKey(a.chat,a.index)!==p.chatId)return;
        if(p.username===getIdentity().username)return;
        setTypingVisible(true,p.name||p.username);
        clearTimeout(typingRemoteTimer); typingRemoteTimer=setTimeout(()=>setTypingVisible(false),1700);
      } else if(p.type==='stopTyping'){
        if(a && chatKey(a.chat,a.index)===p.chatId) setTypingVisible(false);
      } else if(p.type==='message' && p.message){
        saveIncoming(p.chatId,p.message);
      }
    };
  }

  const originalOpenRoom=window.openChatRoom;
  window.openChatRoom=function(index){
    if(typeof originalOpenRoom==='function')originalOpenRoom(index);
    setTimeout(()=>{ensureIds();lastChatSnapshot='';lastRenderedMessageCount=0;setTypingVisible(false);renderLiveMessages(true);const i=document.getElementById('messageInput');if(i){i.removeEventListener('input',handleInput);i.addEventListener('input',handleInput);}},30);
  };

  const originalSend=window.sendChatMessage;
  window.sendChatMessage=function(){
    const a=getActive(); const input=document.getElementById('messageInput');
    if(!a||!input)return;
    const text=input.value.trim(); if(!text)return;
    const identity=getIdentity();
    const msg={id:uid(),text,mine:true,username:identity.username,senderName:identity.name,time:nowTime()};
    const chats=readChats();
    const idx=a.index; if(!chats[idx])return;
    chats[idx].messages=chats[idx].messages||[]; chats[idx].messages.push(msg); chats[idx].last=text; chats[idx].time=msg.time; writeChats(chats);
    input.value='';
    broadcast({type:'stopTyping',chatId:chatKey(chats[idx],idx),username:identity.username,at:Date.now()});
    setTypingVisible(false);
    lastChatSnapshot='';renderLiveMessages(true);
    if(typeof renderChatList==='function')renderChatList();
    if(typeof triggerNightEffect==='function' && /\b(good\s*night|goodnight|gn|sweet\s*dreams)\b/i.test(text)) triggerNightEffect('Good night 🌙');
    broadcast({type:'message',chatId:chatKey(chats[idx],idx),message:{...msg,mine:false}});
  };

  const originalStart=window.startChatFromInput;
  window.startChatFromInput=function(){
    if(typeof originalStart==='function')originalStart();
    setTimeout(()=>{ensureIds();if(typeof renderChatList==='function')renderChatList();},40);
  };

  function addLiveNote(){
    const panel=document.querySelector('#chatOverlay .chat-panel');
    if(!panel||panel.querySelector('.live-note'))return;
    const note=document.createElement('div');note.className='live-note';
    note.innerHTML='<strong>Live chat demo:</strong> typing + messages sync instantly between DREAMORA tabs/windows on this browser.';
    const list=document.getElementById('chatList'); if(list)list.parentNode.insertBefore(note,list);
  }

  document.addEventListener('DOMContentLoaded',()=>{
    ensureIds();addLiveNote();
    const input=document.getElementById('messageInput');
    if(input)input.addEventListener('input',handleInput);
    setTimeout(()=>{if(typeof renderChatList==='function')renderChatList();},100);
  });
  setTimeout(()=>{ensureIds();addLiveNote();const input=document.getElementById('messageInput');if(input)input.addEventListener('input',handleInput);},250);
})();


/* ===== CHAT VISIBILITY FIX V4 ===== */
(function DREAMORA_CHAT_VISIBILITY_FIX(){
  function updateLauncher(){
    const launcher=document.getElementById('chatLauncher');
    if(!launcher)return;
    const home=document.getElementById('home');
    const show=!!(home&&home.classList.contains('active'));
    launcher.classList.toggle('show',show);
  }
  const oldOpen=window.openChat;
  window.openChat=function(){
    const overlay=document.getElementById('chatOverlay');
    if(!overlay)return;
    overlay.classList.add('open');
    if(typeof renderChatList==='function')renderChatList();
  };
  const oldShow=window.showScreen;
  window.showScreen=function(id){
    if(typeof oldShow==='function')oldShow(id);
    setTimeout(updateLauncher,0);
  };
  document.addEventListener('DOMContentLoaded',()=>setTimeout(updateLauncher,50));
  setTimeout(updateLauncher,100);
})();
</script>


<script id="dreamora-chat-v5-patch">
/* DREAMORA CHAT V5 — prototype enhancements */
let dreamoraRecorder=null, dreamoraRecordStarted=0, dreamoraAudioChunks=[];
const dreamoraStickers=['🌙','✨','🌌','💭','😴','🥹','😂','❤️','🫶','☁️','⭐','🦋','🌷','🖤','🤍','🫂','😭','😳','😌','👀'];
function toggleStickerPanel(){
  const p=document.getElementById('stickerPanel'); if(!p)return;
  if(!p.innerHTML)p.innerHTML=dreamoraStickers.map(x=>`<button class="sticker-btn" onclick="sendSticker('${x}')">${x}</button>`).join('');
  p.classList.toggle('open');
}
function sendSticker(sticker){
  const p=document.getElementById('stickerPanel'); if(p)p.classList.remove('open');
  if(activeChat===null)return;
  const chats=getChats(); chats[activeChat].messages=chats[activeChat].messages||[];
  chats[activeChat].messages.push({text:sticker,mine:true,time:new Date().toLocaleTimeString([], {hour:'2-digit',minute:'2-digit'}),sticker:true});
  chats[activeChat].last=sticker; saveChats(chats); renderMessages();
}
async function toggleVoiceRecording(){
  if(activeChat===null)return;
  const btn=document.getElementById('voiceRecordBtn');
  if(dreamoraRecorder && dreamoraRecorder.state==='recording'){
    dreamoraRecorder.stop(); if(btn){btn.classList.remove('recording');btn.textContent='🎙';}
    return;
  }
  if(!navigator.mediaDevices?.getUserMedia || !window.MediaRecorder){alert('Voice recording is not supported by this browser.');return;}
  try{
    const stream=await navigator.mediaDevices.getUserMedia({audio:true});
    dreamoraAudioChunks=[]; dreamoraRecordStarted=Date.now();
    dreamoraRecorder=new MediaRecorder(stream);
    dreamoraRecorder.ondataavailable=e=>{if(e.data.size)dreamoraAudioChunks.push(e.data)};
    dreamoraRecorder.onstop=()=>{
      stream.getTracks().forEach(t=>t.stop());
      const blob=new Blob(dreamoraAudioChunks,{type:'audio/webm'}); const url=URL.createObjectURL(blob);
      const seconds=Math.max(1,Math.round((Date.now()-dreamoraRecordStarted)/1000));
      const chats=getChats(); chats[activeChat].messages=chats[activeChat].messages||[];
      chats[activeChat].messages.push({text:'🎤 Voice message',mine:true,time:new Date().toLocaleTimeString([], {hour:'2-digit',minute:'2-digit'}),voiceUrl:url,duration:seconds});
      chats[activeChat].last=`🎤 Voice message · ${seconds}s`; saveChats(chats); renderMessages(); dreamoraRecorder=null;
    };
    dreamoraRecorder.start(); if(btn){btn.classList.add('recording');btn.textContent='⏹';}
  }catch(e){alert('Microphone permission was not granted. You can still use every other chat feature.');}
}
const _renderMessagesV5=renderMessages;
renderMessages=function(){
  const box=document.getElementById('messageList'); if(!box||activeChat===null)return;
  const chats=getChats(), msgs=chats[activeChat]?.messages||[];
  box.innerHTML=msgs.length?msgs.map(m=>{
    if(m.voiceUrl) return `<div class="bubble ${m.mine?'mine':''}"><div class="voice-bubble">🎤 <audio controls src="${m.voiceUrl}"></audio></div><div class="message-time">${escapeHTML(m.time||'')} · ${m.duration||1}s</div></div>`;
    const txt=escapeHTML(m.text||'');
    return `<div class="bubble ${m.mine?'mine':''}${m.sticker?' sticker-bubble':''}">${txt}<div class="message-time">${escapeHTML(m.time||'')}</div></div>`;
  }).join(''):'<div style="text-align:center;color:#666;padding:35px 10px">Start the conversation 🌙</div>';
  box.scrollTop=box.scrollHeight;
};
/* Close sticker picker when opening the attachment tray. */
const _toggleChatExtrasV5=toggleChatExtras;
toggleChatExtras=function(){const p=document.getElementById('stickerPanel');if(p)p.classList.remove('open');_toggleChatExtrasV5();};
</script>

<script id="dreamora-chat-visible-v6">
(function DREAMORA_CHAT_VISIBLE_V6(){
  function addTopChat(){
    document.querySelectorAll('.topbar').forEach(function(top){
      if(top.querySelector('.dreamora-chat-top-btn')) return;
      var b=document.createElement('button');
      b.className='create-top-btn dreamora-chat-top-btn';
      b.type='button';
      b.textContent='💬 Chat';
      b.title='Open DREAMORA Chat';
      b.onclick=function(e){e.preventDefault();e.stopPropagation();openChat();};
      b.style.marginLeft='8px';
      top.appendChild(b);
    });
  }
  function refresh(){
    addTopChat();
    var l=document.getElementById('chatLauncher');
    if(l) l.style.display='none';
    document.querySelectorAll('.dreamora-chat-top-btn').forEach(function(b){
      var home=document.getElementById('home');
      b.style.display=(home && home.classList.contains('active'))?'inline-flex':'none';
    });
  }
  if(document.readyState==='loading') document.addEventListener('DOMContentLoaded',function(){setTimeout(refresh,50);});
  else setTimeout(refresh,50);
  setInterval(refresh,1200);
})();
</script>
</body>
</html>